SUPABASE_BACKUP_BUCKET=flowboard-backups
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pinecone index with integrated embeddings, field_map text = chunk_text.
