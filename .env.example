HERMES_API_KEY=
# OpenAI-compatible generation service, e.g. a self-hosted Ollama server.
# Local development example: http://127.0.0.1:11434/v1 and qwen2.5:3b
AI_BASE_URL=
AI_REASONING_EFFORT=
AI_MODEL=
AI_API_KEY=

# Optional sanitized error reporting and sampled performance traces.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional AI providers (server-only; never NEXT_PUBLIC)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
